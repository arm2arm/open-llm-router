{
  "realm": "olr-demo",
  "enabled": true,
  "displayName": "Open LLM Router demo",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "groups": [{"name": "staff"}, {"name": "admins"}],
  "clients": [{
    "clientId": "olr-portal",
    "enabled": true,
    "protocol": "openid-connect",
    "publicClient": false,
    "secret": "${OIDC_PORTAL_CLIENT_SECRET}",
    "standardFlowEnabled": true,
    "implicitFlowEnabled": false,
    "directAccessGrantsEnabled": false,
    "redirectUris": ["${PORTAL_BASE_URL}/portal/callback"],
    "webOrigins": ["${PORTAL_BASE_URL}"],
    "attributes": {
      "pkce.code.challenge.method": "S256",
      "post.logout.redirect.uris": "${PORTAL_BASE_URL}/"
    },
    "protocolMappers": [{
      "name": "groups",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-group-membership-mapper",
      "config": {
        "claim.name": "groups",
        "full.path": "false",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "userinfo.token.claim": "true"
      }
    }]
  }],
  "users": [{
    "username": "staff",
    "enabled": true,
    "email": "staff@example.test",
    "emailVerified": true,
    "firstName": "Demo",
    "lastName": "Staff",
    "groups": ["/staff"],
    "credentials": [{"type": "password", "value": "${OLR_DEMO_USER_PASSWORD}", "temporary": false}]
  }]
}
