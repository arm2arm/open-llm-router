    given-names: "Arman"
    affiliation: "Leibniz Institute for Astrophysics Potsdam (AIP)"
repository-code: "https://github.com/arm2arm/open-llm-router"
url: "https://github.com/arm2arm/open-llm-router"
license: MIT
version: "0.0.1"
date-released: "2026-11-06"
keywords:
  - LLM
  - router
  - gateway
  - vLLM
  - Ollama
  - SGLang
