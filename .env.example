# Optional: copy to .env at the repository root. Compose works without this file.
# All values here are public local-development defaults, not deployment secrets.

# Local-only mode (no Keycloak dependency):
# docker compose -f deploy/compose/docker-compose.yml -f deploy/compose/local-only.yml up --build --detach --wait
# Supply one private OLR_BOOTSTRAP_ADMIN_PASSWORD[_FILE] source below; no
# administrator password is supplied by either mode. For a disposable test run:
# make acceptance-local

# Ports published on 127.0.0.1. Container ports and pool URLs stay unchanged.
OLR_PORT=8080
POSTGRES_PORT=5432
MOCK_A_PORT=8001
MOCK_B_PORT=8002
KEYCLOAK_PORT=8081

# Optional laptop Ollama backend (paths are relative to deploy/compose).
# OLR_CONFIG_FILE=../../config.ollama.example.yaml
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen3.8:27b-mlx
# Private GPU networks allowed for Admin-added endpoints (comma-separated CIDRs).
# OLR_BACKEND_ALLOWED_CIDRS=192.168.178.0/24
# Names of backend token environment variables that Admin may select.
# OLR_BACKEND_TOKEN_ENVS=VLLM_API_KEY

# Postgres initialization applies only when the named volume is empty.
# Keep the URL in sync when changing the user, database or password; URI-encode
# special characters in the URL's credentials. The URL uses the service hostname.
POSTGRES_USER=olr
POSTGRES_DB=olr
POSTGRES_PASSWORD=olr-dev-only
OLR_DATABASE_URL=postgres://olr:olr-dev-only@postgres:5432/olr?sslmode=disable

# Optional key for SSO client secrets stored by olr admin settings.
# Generate and protect it the same way; environment references work without it.
# OLR_SETTINGS_ENCRYPTION_KEY=

# Optional protected local router administrator (distinct from Keycloak admin).
# Supply exactly one private bootstrap source; no default password is provided.
# A file must be mounted separately, owned/readable by UID 65532, mode 0400/0600.
# OLR_BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/olr-secrets/bootstrap
# OLR_BOOTSTRAP_ADMIN_PASSWORD=
# Complete the first password change, then retire the source. See ADMIN_GUIDE.md.

# Public issuer stays identical in discovery and ID tokens. The router transports
# its requests through the internal backchannel; this never skips issuer checks.
OIDC_ISSUER=http://localhost:8081/realms/olr-dev
OIDC_PORTAL_CLIENT_ID=olr-portal
OIDC_PORTAL_CLIENT_SECRET=olr-portal-dev-only
OIDC_GROUPS_CLAIM=groups
OIDC_USERNAME_CLAIM=preferred_username
OIDC_BACKCHANNEL_URL=http://keycloak:8080/realms/olr-dev
# Keycloak access tokens on /v1/* need this audience; empty disables them.
OIDC_AUDIENCE=olr-api
# Read-only service account for the group sync job; empty secret disables it.
OIDC_SYNC_CLIENT_ID=olr-sync
OIDC_SYNC_CLIENT_SECRET=olr-sync-dev-only
PORTAL_BASE_URL=http://localhost:8080
PORTAL_COOKIE_SECURE=false
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=keycloak-admin-dev-only

# Metrics are refused until a dedicated bearer token is set. Never reuse an API key.
OLR_METRICS_TOKEN=
# OTLP/HTTP protobuf. Empty endpoint means no spans. Generic endpoint appends
# /v1/traces; a traces-specific endpoint is a complete URL and takes precedence.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Optional exporter authentication, e.g. Authorization=Bearer%20collector-token.
OTEL_EXPORTER_OTLP_HEADERS=
OLR_TRACE_USER_ID=false

# Both replicas serve chat-model. A is twice as fast as B, matching pool weights.
MOCK_TOKENS=16
MOCK_A_TOKEN_DELAY=20ms
MOCK_B_TOKEN_DELAY=40ms

# Host-side tests read this separately from Compose; leave empty to skip DB tests.
# Export it before `make test` to exercise Postgres. Adjust for POSTGRES_PORT.
# The test role needs CREATEDB; tests create/drop isolated temporary databases.
OLR_TEST_DATABASE_URL=
# OLR_TEST_DATABASE_URL=postgres://olr:olr-dev-only@127.0.0.1:5432/olr?sslmode=disable
