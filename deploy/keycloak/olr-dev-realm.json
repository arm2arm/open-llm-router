{
  "realm": "olr-dev",
  "enabled": true,
  "displayName": "Open LLM Router development",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "resetPasswordAllowed": false,
  "groups": [
    {
      "name": "staff"
    },
    {
      "name": "students"
    },
    {
      "name": "admins"
    }
  ],
  "clients": [
    {
      "clientId": "olr-portal",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "olr-portal-dev-only",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${PORTAL_BASE_URL}/portal/callback"
      ],
      "webOrigins": [
        "${PORTAL_BASE_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${PORTAL_BASE_URL}/"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "affiliation",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "affiliation",
            "claim.name": "affiliation",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "olr-api",
      "name": "Router API audience",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "olr-sync",
      "name": "Router group sync (read-only)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "olr-sync-dev-only",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "kc-admin-api",
        "roles",
        "basic",
        "acr",
        "web-origins",
        "profile",
        "email"
      ]
    },
    {
      "clientId": "olr-service",
      "name": "Example service calling the API with client credentials",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "olr-service-dev-only",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "olr-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "olr-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "staff",
      "email": "staff@example.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Dev",
      "lastName": "Staff",
      "groups": [
        "/staff"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "staff-dev-only",
          "temporary": false
        }
      ],
      "attributes": {
        "affiliation": [
          "member@example.org"
        ]
      }
    },
    {
      "username": "student",
      "email": "student@example.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Dev",
      "lastName": "Student",
      "groups": [
        "/students"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "student-dev-only",
          "temporary": false
        }
      ],
      "attributes": {
        "affiliation": [
          "member@example.org"
        ]
      }
    },
    {
      "username": "admin",
      "email": "admin@example.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Dev",
      "lastName": "Admin",
      "groups": [
        "/admins"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "admin-dev-only",
          "temporary": false
        }
      ],
      "attributes": {
        "affiliation": [
          "member@example.org"
        ]
      }
    },
    {
      "username": "service-account-olr-sync",
      "enabled": true,
      "serviceAccountClientId": "olr-sync",
      "clientRoles": {
        "realm-management": [
          "view-users"
        ]
      }
    },
    {
      "username": "service-account-olr-service",
      "enabled": true,
      "serviceAccountClientId": "olr-service",
      "groups": [
        "/staff"
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\": \"ENABLED\", \"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "identityProviders": [
    {
      "alias": "upstream-idp",
      "displayName": "Upstream IdP",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "config": {
        "clientId": "olr-broker",
        "clientSecret": "olr-broker-dev-only",
        "clientAuthMethod": "client_secret_post",
        "authorizationUrl": "http://localhost:${KEYCLOAK_PORT:8081}/realms/upstream-idp/protocol/openid-connect/auth",
        "tokenUrl": "http://localhost:8080/realms/upstream-idp/protocol/openid-connect/token",
        "jwksUrl": "http://localhost:8080/realms/upstream-idp/protocol/openid-connect/certs",
        "userInfoUrl": "http://localhost:8080/realms/upstream-idp/protocol/openid-connect/userinfo",
        "issuer": "http://localhost:${KEYCLOAK_PORT:8081}/realms/upstream-idp",
        "validateSignature": "true",
        "useJwksUrl": "true",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "defaultScope": "openid profile email",
        "syncMode": "FORCE"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "affiliation",
      "identityProviderAlias": "upstream-idp",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "claim": "affiliation",
        "user.attribute": "affiliation"
      }
    },
    {
      "name": "members are students",
      "identityProviderAlias": "upstream-idp",
      "identityProviderMapper": "oidc-advanced-group-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "claims": "[{\"key\": \"affiliation\", \"value\": \"member@example.org\"}]",
        "are.claim.values.regex": "false",
        "group": "/students"
      }
    }
  ]
}
