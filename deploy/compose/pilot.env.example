# Copy outside the checkout, chmod 600, and fill every empty required value.
# docs/PILOT.md shows how this file is passed to Compose and the container.
# Single-quote values containing $, # or spaces; do not commit the result.
OLR_IMAGE=
OLR_SITE_CONFIG=/absolute/private/path/config.yaml
OLR_PORT=8080
OLR_DATABASE_URL=
# Optional one-time local administrator bootstrap; no default password.
# Prefer a private file mounted in a site override, UID 65532, mode 0400/0600.
# OLR_BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/olr-secrets/bootstrap
# Alternative: OLR_BOOTSTRAP_ADMIN_PASSWORD= (secret; supply a unique value)
# Rotate with `olr admin password change`, then retire the source; see ADMIN_GUIDE.md.
OIDC_ISSUER=
OIDC_PORTAL_CLIENT_ID=olr-portal
OIDC_PORTAL_CLIENT_SECRET=
OIDC_AUDIENCE=olr-api
OIDC_SYNC_CLIENT_ID=olr-sync
OIDC_SYNC_CLIENT_SECRET=
OIDC_REQUIRED_CLAIM=
PORTAL_BASE_URL=
OLR_METRICS_TOKEN=

# Both replicas must serve this model and support the configured protocols.
OLR_UPSTREAM_MODEL=
OLR_BACKEND_A_URL=
OLR_BACKEND_B_URL=
VLLM_A_API_KEY=
VLLM_B_API_KEY=
# Starting examples only: choose from measured backend capacity.
OLR_BACKEND_A_WEIGHT=1
OLR_BACKEND_B_WEIGHT=1
OLR_BACKEND_A_MAX_INFLIGHT=4
OLR_BACKEND_B_MAX_INFLIGHT=4

# Agree these values with the site and publish matching retention periods.
OLR_TIMEZONE=UTC
OLR_USAGE_DAYS=90
OLR_USAGE_DAILY_DAYS=400
OLR_PILOT_TOKENS_PER_DAY=500000
OLR_PILOT_TOKENS_PER_MONTH=5000000
OLR_PILOT_RPM=20
OLR_PILOT_TPM=20000
OLR_PILOT_MAX_CONCURRENT=2

# Optional: use the site's collector and retention, with no user IDs by default.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.org:4318
