        }
      }
    },
    {
      "type": "state-timeline",
      "title": "Replica health",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "olr_replica_healthy{model=~\"$model\"}",
          "legendFormat": "{{model}} {{replica}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "red"
                },
                "1": {
                  "text": "healthy",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Calls waiting for a replica",
      "description": "Queue of models with queue_timeout_s; calls that time out get 503.",
      "datasource": {
